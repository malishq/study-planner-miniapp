[Unit]
Description=Study planner Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/study-planner-miniapp/bot
EnvironmentFile=/opt/study-planner-miniapp/bot/.env
ExecStart=/opt/study-planner-miniapp/bot/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
